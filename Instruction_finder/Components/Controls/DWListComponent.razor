@inject ICheckIfInstructionExistUseCase CheckIfInstructionExistUseCase
@inject ILogger<DWListComponent> Logger

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <p class="text-danger">@errorMessage</p>
}
else if (availableDW.Any())
{
    @foreach (var dw in availableDW)
    {
        <button class="btn btn-outline-primary m-1"
                @onclick="() => SelectDW(dw)">
            @dw
        </button>
    }
}
else if (!string.IsNullOrWhiteSpace(CurrentPart.PartNumber))
{
    <p>Nie znaleziono części o podanym numerze.</p>
}

@code {

    [Parameter]
    public Part CurrentPart { get; set; } = default!;

    [Parameter]
    public EventCallback<string> OnDWSelected { get; set; }

    private List<string> availableDW = new();
    private string? errorMessage;

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(CurrentPart.PartNumber))
        {
            try
            {
                errorMessage = null;
                availableDW = CheckIfInstructionExistUseCase.Execute(CurrentPart);
            }
            catch (Exception exception)
            {
                availableDW.Clear();
                var baseException = exception.GetBaseException();
                errorMessage = $"Nie udało się wyszukać części. Wystąpił problem z bazą danych: {baseException.Message}";
                Logger.LogError(exception, "Błąd podczas wyszukiwania części {PartNumber}", CurrentPart.PartNumber);
            }
        }
        else
        {
            availableDW.Clear();
            errorMessage = null;
        }
    }

    private async Task SelectDW(string dw)
    {
       

        await OnDWSelected.InvokeAsync(dw);
    }

}
