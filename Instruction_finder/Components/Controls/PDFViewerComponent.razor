
@if (string.IsNullOrWhiteSpace(PdfPath))
{
    <div class="pdf-viewer-empty"></div>
}
else
{
    <div class="pdf-viewer-container">
        <iframe class="pdf-viewer-frame"
                src="@PdfUrl"
                @key="PdfUrl"
            >
        </iframe>
    </div>
}

@code {
    [Parameter]
    public string PdfPath { get; set; } = string.Empty;

    private string PdfUrl => $"/pdf?path={Uri.EscapeDataString($@"C:\Users\jacuu\source\repos\Instruction_finder\testowe_Pdf\{PdfPath}.pdf")}";
    ///private string PdfUrl => $"/pdf?path={Uri.EscapeDataString(PdfPath)}";
}